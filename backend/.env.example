# Copy to .env and fill in. Never commit .env.

# Supabase dashboard -> Connect -> "Session pooler" connection string.
# Change the scheme to postgresql+psycopg:// and URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Token verification. Fill in ONE of these, depending on your project:
#  - SUPABASE_URL: projects using JWT signing keys (asymmetric). Verified via {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#  - SUPABASE_JWT_SECRET: projects still on the legacy shared JWT secret (HS256)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=

# AI provider: "fake" needs no key (deterministic placeholder copy) - use it for the sprint demo.
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY="your_key_here"

# Logging in the uvicorn terminal: DEBUG, INFO (requests, sign-ins, activity) or WARNING
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
